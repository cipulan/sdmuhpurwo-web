<style>
    .footer {
        margin-top: 2rem;
    }

    .footer-main {
        background-color: var(--color-surface);
        padding: 4rem 0 2rem;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 2rem;
    }

    .footer-logo {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .footer-logo-img {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(233, 30, 140, 0.3);
    }

    .footer-brand {
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.3;
    }

    .footer-tagline {
        font-size: 0.85rem;
        color: var(--color-primary);
        font-weight: 500;
    }

    .footer-desc {
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    .footer-col h4 {
        color: var(--color-text);
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
        position: relative;
        padding-bottom: 0.75rem;
    }

    .footer-col h4::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 2px;
        background: var(--gradient-holographic);
    }

    .footer-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .footer-list li {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .social-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--color-text-muted);
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

    .social-link:hover {
        color: var(--color-primary);
        transform: translateX(4px);
    }

    .footer-bottom {
        background-color: var(--color-background);
        padding: 1.5rem 0;
        text-align: center;
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    @media (max-width: 768px) {
        .footer-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }
</style>
