---

<button id="scroll-to-top" class="scroll-to-top glass" aria-label="Scroll to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
</button>

<style>
    .scroll-to-top {
        position: fixed;
        bottom: 6.5rem; /* Posisikan tepat di atas tombol WhatsApp */
        right: calc(2rem + 7.5px); /* Agar center sejajar dengan WA button (60px vs 45px) */
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--color-glass-bg);
        color: var(--color-text);
        border: 1px solid var(--color-border-heavy);
        z-index: 999;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: var(--shadow-md);
    }
    
    .scroll-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .scroll-to-top:not(.visible) {
        transform: translateY(20px);
    }

    .scroll-to-top:hover {
        background: var(--color-primary);
        color: white;
        border-color: var(--color-primary);
        transform: translateY(-3px);
    }
    
    @media (max-width: 768px) {
        .scroll-to-top {
            bottom: 6rem;
            right: calc(1.5rem + 7.5px);
        }
    }
</style>

<script>
    const scrollToTopBtn = document.getElementById('scroll-to-top');

    const toggleVisibility = () => {
        if (window.scrollY > 300) {
            scrollToTopBtn?.classList.add('visible');
        } else {
            scrollToTopBtn?.classList.remove('visible');
        }
    };

    window.addEventListener('scroll', toggleVisibility);

    scrollToTopBtn?.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
</script>
