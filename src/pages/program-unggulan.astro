---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Program Unggulan">
    <main>
        <!-- Hero Section -->
        <section class="page-header">
            <div class="container">
                <h1 class="page-title">
                    Program <span class="text-gradient">Unggulan</span>
                </h1>
                <p class="page-subtitle">
                    Pendidikan terbaik melalui perpaduan ilmu, akhlak, dan
                    kolaborasi keluarga.
                </p>
            </div>
        </section>

        <!-- Intro Section -->
        <section class="section">
            <div class="container container-sm text-center">
                <p class="intro-text">
                    Kami percaya bahwa pendidikan terbaik lahir dari perpaduan
                    antara ilmu, akhlak, dan kedekatan dengan keluarga. Karena
                    itu, SD Muhammadiyah Purwodiningratan menghadirkan
                    program-program unggulan yang dirancang untuk membentuk
                    generasi yang cerdas, cinta Al-Qur'an, dan berkarakter kuat
                    — dengan melibatkan peran aktif orang tua di setiap
                    langkahnya.
                </p>
            </div>
        </section>

        <!-- Programs Section -->
        <section class="section pt-0">
            <div class="container">
                <div class="programs-list">
                    <!-- Tahsin UMMI -->
                    <div class="program-card glass">
                        <div class="program-icon">📖</div>
                        <div class="program-content">
                            <h2>
                                Tahsin <span class="text-gradient">UMMI</span>
                            </h2>
                            <p class="program-desc">
                                Program pembinaan baca Al-Qur'an menggunakan <strong
                                    >Metode UMMI</strong
                                >, sebuah metode yang teruji efektif membimbing
                                siswa membaca Al-Qur'an dengan tartil, sesuai
                                kaidah tajwid, secara bertahap dan menyenangkan.
                            </p>
                            <div class="program-features">
                                <h3>Yang membuat program ini istimewa:</h3>
                                <ul>
                                    <li>
                                        Pembelajaran dilakukan dalam kelompok
                                        kecil sehingga setiap siswa mendapat
                                        perhatian penuh dari guru
                                        (mu'allim/mu'allimah) bersertifikat
                                        UMMI.
                                    </li>
                                    <li>
                                        Sistem jenjang yang jelas, mulai dari
                                        pengenalan huruf hijaiyah hingga
                                        kemampuan membaca Al-Qur'an dengan
                                        lancar dan benar.
                                    </li>
                                    <li>
                                        Evaluasi berkala (munaqasyah) untuk
                                        memastikan setiap siswa benar-benar
                                        menguasai tiap jilid sebelum naik ke
                                        tingkat berikutnya.
                                    </li>
                                    <li>
                                        Menanamkan kecintaan terhadap Al-Qur'an
                                        sejak dini, bukan sekadar kemampuan
                                        membaca.
                                    </li>
                                </ul>
                            </div>
                            <div class="program-target">
                                <strong>Target:</strong> Seluruh siswa, dengan penempatan
                                kelas sesuai hasil placement test di awal masuk.
                            </div>
                        </div>
                    </div>

                    <!-- Qur'an Camp -->
                    <div class="program-card glass reverse">
                        <div class="program-icon">⛺</div>
                        <div class="program-content">
                            <h2>
                                Qur'an <span class="text-gradient">Camp</span>
                            </h2>
                            <p class="program-desc">
                                Sebuah program <em>retreat</em> tahunan yang mengajak
                                siswa keluar dari rutinitas kelas untuk menyelami
                                Al-Qur'an secara lebih mendalam, sekaligus melatih
                                kemandirian, kerja sama, dan kedisiplinan dalam suasana
                                alam terbuka.
                            </p>
                            <div class="program-features">
                                <h3>Kegiatan yang dirancang penuh makna:</h3>
                                <ul>
                                    <li>
                                        Tahfidz dan muroja'ah intensif dengan
                                        pendampingan pembimbing.
                                    </li>
                                    <li>
                                        Kajian tematik yang mengaitkan
                                        nilai-nilai Al-Qur'an dengan kehidupan
                                        sehari-hari.
                                    </li>
                                    <li>
                                        Outbound dan permainan edukatif yang
                                        menumbuhkan jiwa kepemimpinan dan kerja
                                        sama tim.
                                    </li>
                                    <li>
                                        Malam bina iman (qiyamullail, muhasabah)
                                        yang membekas dalam pengalaman spiritual
                                        siswa.
                                    </li>
                                </ul>
                            </div>
                            <div class="program-target">
                                <strong>Manfaat bagi siswa:</strong> Membangun kedekatan
                                emosional dengan Al-Qur'an, melatih kemandirian jauh
                                dari orang tua, serta mempererat ukhuwah antar siswa
                                dan guru.
                            </div>
                        </div>
                    </div>

                    <!-- Open School -->
                    <div class="program-card glass">
                        <div class="program-icon">🏫</div>
                        <div class="program-content">
                            <h2>
                                Open <span class="text-gradient">School</span>
                            </h2>
                            <p class="program-desc">
                                Kesempatan bagi keluarga besar dan calon siswa
                                untuk mengenal lebih dekat lingkungan belajar,
                                kurikulum, dan keseharian di SD Muhammadiyah
                                Purwodiningratan — langsung dari sumbernya.
                            </p>
                            <div class="program-features">
                                <h3>Apa yang bisa didapatkan pengunjung:</h3>
                                <ul>
                                    <li>
                                        Tur keliling fasilitas sekolah: ruang
                                        kelas, perpustakaan, mushola, dan area
                                        bermain.
                                    </li>
                                    <li>
                                        Sesi tanya jawab langsung dengan kepala
                                        sekolah, guru, dan tim kurikulum.
                                    </li>
                                    <li>
                                        Demo pembelajaran (<em>mini class</em>)
                                        agar calon siswa merasakan langsung
                                        suasana belajar.
                                    </li>
                                    <li>
                                        Pameran karya siswa dan capaian prestasi
                                        sekolah.
                                    </li>
                                </ul>
                            </div>
                            <div class="program-target">
                                <strong>Cocok untuk:</strong> Calon siswa baru dan
                                orang tua yang ingin mengenal visi, misi, serta metode
                                pendidikan sekolah sebelum mendaftar.
                            </div>
                        </div>
                    </div>

                    <!-- Parents Day -->
                    <div class="program-card glass reverse">
                        <div class="program-icon">👨‍👩‍👧</div>
                        <div class="program-content">
                            <h2>
                                Parents <span class="text-gradient">Day</span>
                            </h2>
                            <p class="program-desc">
                                Karena pendidikan terbaik adalah kolaborasi
                                antara sekolah dan rumah, Parents Day hadir
                                sebagai wadah bagi orang tua untuk terlibat
                                langsung dalam proses tumbuh kembang anak di
                                sekolah.
                            </p>
                            <div class="program-features">
                                <h3>Rangkaian acara meliputi:</h3>
                                <ul>
                                    <li>
                                        Laporan perkembangan akademik dan
                                        karakter siswa secara personal dari wali
                                        kelas.
                                    </li>
                                    <li>
                                        Showcase karya dan pencapaian siswa
                                        selama satu semester.
                                    </li>
                                    <li>
                                        Talkshow atau seminar parenting dengan
                                        narasumber kompeten.
                                    </li>
                                    <li>
                                        Sesi kebersamaan orang tua dan anak
                                        melalui aktivitas kolaboratif.
                                    </li>
                                </ul>
                            </div>
                            <div class="program-target">
                                <strong>Tujuan program:</strong> Mempererat komunikasi
                                sekolah dan orang tua, serta memastikan pendampingan
                                anak berjalan selaras antara di sekolah dan di rumah.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="section cta-section">
            <div class="container text-center">
                <h2 class="cta-title">Tertarik bergabung bersama kami?</h2>
                <p class="cta-desc">
                    Kunjungi sekolah kami langsung melalui program <strong
                        >Open School</strong
                    >, atau hubungi kami untuk informasi pendaftaran lebih
                    lanjut.
                </p>
                <div class="cta-buttons">
                    <a
                        href="https://api.whatsapp.com/send?phone=6282225341300"
                        target="_blank"
                        class="btn btn-primary">Hubungi WhatsApp</a
                    >
                    <a href="/kontak" class="btn btn-outline"
                        >Lihat Lokasi Sekolah</a
                    >
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        padding: 6rem 0 3rem;
        text-align: center;
        background: var(--gradient-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .page-title {
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 1.2rem;
        font-weight: 500;
        max-width: 700px;
        margin: 0 auto;
    }

    .container-sm {
        max-width: 800px;
        margin: 0 auto;
    }

    .text-center {
        text-align: center;
    }

    .pt-0 {
        padding-top: 0;
    }

    .intro-text {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--color-text);
        margin-bottom: 2rem;
    }

    .programs-list {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .program-card {
        display: flex;
        align-items: flex-start;
        gap: 3rem;
        padding: 3rem;
        border-radius: var(--radius-xl);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .program-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .program-card.reverse {
        flex-direction: row-reverse;
    }

    .program-icon {
        font-size: 5rem;
        line-height: 1;
        flex-shrink: 0;
        background: var(--color-surface);
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-md);
    }

    .program-content {
        flex: 1;
    }

    .program-content h2 {
        font-size: 2.2rem;
        margin-bottom: 1rem;
    }

    .program-desc {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--color-text);
        margin-bottom: 2rem;
    }

    .program-features {
        margin-bottom: 2rem;
    }

    .program-features h3 {
        font-size: 1.1rem;
        color: var(--color-primary-light);
        margin-bottom: 1rem;
    }

    .program-features ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .program-features ul li {
        position: relative;
        padding-left: 1.5rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }

    .program-features ul li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--color-primary);
        font-weight: bold;
    }

    .program-target {
        padding: 1rem 1.5rem;
        background: rgba(233, 30, 140, 0.1);
        border-left: 4px solid var(--color-primary);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        color: var(--color-text);
        line-height: 1.6;
    }

    .program-target strong {
        color: var(--color-primary);
    }

    .cta-section {
        background: var(--gradient-surface);
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
        padding: 5rem 0;
    }

    .cta-title {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: var(--color-text);
    }

    .cta-desc {
        font-size: 1.2rem;
        color: var(--color-text-muted);
        margin-bottom: 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    @media (max-width: 992px) {
        .program-card,
        .program-card.reverse {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2.5rem;
        }

        .program-features ul li {
            text-align: left;
        }

        .program-target {
            text-align: left;
        }
    }

    @media (max-width: 768px) {
        .cta-buttons {
            flex-direction: column;
        }

        .program-card {
            padding: 1.5rem;
        }
    }
</style>
