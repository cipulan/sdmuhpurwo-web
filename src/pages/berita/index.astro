---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBerita = await getCollection('berita');
const sortedBerita = allBerita.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Berita & Pengumuman">
    <main>
        <section class="page-header">
            <div class="container">
                <h1 class="page-title">Berita & <span class="text-gradient">Pengumuman</span></h1>
                <p class="page-subtitle">Informasi terbaru seputar kegiatan dan prestasi SD Muhammadiyah Purwodiningratan</p>
            </div>
        </section>

        <section class="berita-list section">
            <div class="container">
                <div class="berita-grid">
                    {sortedBerita.map((post) => (
                        <article class="berita-card glass">
                            <div class="berita-image-wrapper">
                                <img src={post.data.image} alt={post.data.title} class="berita-image" />
                            </div>
                            <div class="berita-content">
                                <div class="berita-meta">
                                    <span class="berita-date">📅 {post.data.date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                                </div>
                                <h2 class="berita-title">
                                    <a href={`/berita/${post.id}`}>{post.data.title}</a>
                                </h2>
                                <p class="berita-excerpt">{post.data.excerpt}</p>
                                <a href={`/berita/${post.id}`} class="read-more">Baca selengkapnya <span>→</span></a>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        padding: 6rem 0 3rem;
        text-align: center;
        background: var(--gradient-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .page-title {
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 1rem;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .berita-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .berita-card {
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .berita-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-glow);
    }

    .berita-image-wrapper {
        width: 100%;
        height: 200px;
        overflow: hidden;
    }

    .berita-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .berita-card:hover .berita-image {
        transform: scale(1.05);
    }

    .berita-content {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .berita-meta {
        font-size: 0.9rem;
        color: var(--color-primary-light);
        margin-bottom: 0.5rem;
    }

    .berita-title {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        line-height: 1.4;
    }

    .berita-title a {
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .berita-title a:hover {
        color: var(--color-primary);
    }

    .berita-excerpt {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        flex: 1;
    }

    .read-more {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-primary);
        font-weight: 600;
        text-decoration: none;
        transition: gap 0.3s ease;
    }

    .read-more:hover {
        gap: 0.75rem;
    }
</style>
