---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const beritaEntries = await getCollection('berita');
    return beritaEntries.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout 
    title={entry.data.title}
    description={entry.data.excerpt}
    image={entry.data.image}
>
    <main>
        <article class="article-container">
            <header class="article-header">
                <div class="container container-sm">
                    <a href="/berita" class="back-link">← Kembali ke Berita</a>
                    <div class="article-meta">
                        <span>📅 {entry.data.date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                        <span>|</span>
                        <span>✍️ {entry.data.author}</span>
                    </div>
                    <h1 class="article-title">{entry.data.title}</h1>
                </div>
            </header>

            <div class="article-hero">
                <div class="container container-sm">
                    <img src={entry.data.image} alt={entry.data.title} class="hero-image" />
                </div>
            </div>

            <div class="container container-sm">
                <div class="article-content glass">
                    <Content />
                </div>
            </div>
        </article>
    </main>
</Layout>

<style>
    .container-sm {
        max-width: 800px;
        margin: 0 auto;
    }

    .article-header {
        padding: 4rem 0 2rem;
        text-align: center;
    }

    .back-link {
        display: inline-block;
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: transform 0.3s ease;
    }

    .back-link:hover {
        transform: translateX(-5px);
    }

    .article-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: var(--color-primary-light);
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .article-title {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        line-height: 1.3;
        color: var(--color-text);
    }

    .article-hero {
        margin-bottom: 3rem;
    }

    .hero-image {
        width: 100%;
        height: auto;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--color-border);
    }

    .article-content {
        padding: 2.5rem;
        border-radius: var(--radius-lg);
        margin-bottom: 4rem;
        line-height: 1.8;
        font-size: 1.05rem;
        color: var(--color-text);
    }

    /* Markdown Styling */
    .article-content :global(h2) {
        font-size: 1.8rem;
        margin: 2rem 0 1rem;
        color: var(--color-text);
    }

    .article-content :global(p) {
        margin-bottom: 1.5rem;
        color: var(--color-text-muted);
    }

    .article-content :global(ul), .article-content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
        color: var(--color-text-muted);
    }

    .article-content :global(li) {
        margin-bottom: 0.5rem;
    }

    @media (max-width: 768px) {
        .article-content {
            padding: 1.5rem;
        }
    }
</style>
