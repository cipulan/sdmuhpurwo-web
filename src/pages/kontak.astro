---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontak Kami">
    <main>
        <section class="page-header">
            <div class="container">
                <h1 class="page-title">Kontak <span class="text-gradient">Kami</span></h1>
                <p class="page-subtitle">Silakan hubungi kami atau kunjungi lokasi sekolah untuk informasi lebih lanjut.</p>
            </div>
        </section>

        <section class="kontak-section section">
            <div class="container">
                <div class="kontak-grid">
                    
                    <!-- Informasi Kontak -->
                    <div class="kontak-info glass">
                        <h2>Informasi <span class="text-gradient">Sekolah</span></h2>
                        <p class="intro-text">Kami selalu terbuka untuk berdiskusi dan membantu Anda terkait penerimaan siswa baru maupun program pendidikan kami.</p>
                        
                        <div class="info-list">
                            <div class="info-item">
                                <span class="icon">📍</span>
                                <div>
                                    <h3>Alamat</h3>
                                    <p>Jl. Purwodiningratan No.123, Ngampilan, Kota Yogyakarta, Daerah Istimewa Yogyakarta 55261</p>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="icon">📞</span>
                                <div>
                                    <h3>Telepon / WhatsApp</h3>
                                    <p>+62 822-2534-1300</p>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="icon">✉️</span>
                                <div>
                                    <h3>Email</h3>
                                    <p>info@sdmuhpurwo.sch.id</p>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="icon">🕒</span>
                                <div>
                                    <h3>Jam Operasional</h3>
                                    <p>Senin - Jumat: 07.00 - 15.00 WIB</p>
                                    <p>Sabtu: 07.00 - 12.00 WIB</p>
                                </div>
                            </div>
                        </div>
                        
                        <a href="https://api.whatsapp.com/send?phone=6282225341300" target="_blank" class="btn btn-wa mt-2">
                            💬 Chat dengan Admin
                        </a>
                    </div>
                    
                    <!-- Peta Google Maps -->
                    <div class="kontak-map glass">
                        <div class="map-wrapper">
                            <iframe 
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3952.995958!2d110.3550763!3d-7.7997995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a578ba7f7602d%3A0x279ef21c60568d54!2sSD%20Muhammadiyah%20Purwodiningratan!5e0!3m2!1sen!2sid" 
                                class="map-iframe"
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        padding: 6rem 0 3rem;
        text-align: center;
        background: var(--gradient-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .page-title {
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 1rem;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .kontak-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
    }

    .kontak-info {
        padding: 2.5rem;
        border-radius: var(--radius-xl);
    }

    .kontak-info h2 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
    }

    .intro-text {
        color: var(--color-text-muted);
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .info-item .icon {
        font-size: 1.5rem;
        padding: 0.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .info-item h3 {
        font-size: 1.1rem;
        color: var(--color-text);
        margin-bottom: 0.25rem;
    }

    .info-item p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin: 0;
    }

    .mt-2 {
        margin-top: 1rem;
    }
    
    .btn-wa {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #25D366;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 2rem;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        width: 100%;
    }

    .btn-wa:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
    }

    .kontak-map {
        padding: 1rem;
        border-radius: var(--radius-xl);
    }

    .map-wrapper {
        width: 100%;
        height: 500px;
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .map-iframe {
        width: 100%;
        height: 100%;
        border: 0;
        transition: filter 0.5s ease;
    }

    /* Dark Mode Map Hack */
    :global([data-theme="dark"]) .map-iframe {
        filter: invert(90%) hue-rotate(180deg) contrast(1.1);
    }

    @media (max-width: 992px) {
        .kontak-grid {
            grid-template-columns: 1fr;
        }
        
        .map-wrapper {
            height: 400px;
        }
    }
</style>
