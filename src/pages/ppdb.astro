---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="PPDB">
    <section class="page-header">
        <div class="page-header-bg"></div>
        <div class="container animate-fade-up">
            <h1 class="page-title">
                Penerimaan Peserta<br /><span class="text-gradient"
                    >Didik Baru</span
                >
            </h1>
            <p class="page-subtitle">
                Mari Bergabung Menjadi Bagian dari Keluarga Besar SD
                Muhammadiyah Purwodiningratan!
            </p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="ppdb-content">
                <div class="info-text animate-fade-up">
                    <p>
                        Ayah/Bunda, pendataan siswa baru untuk tahun ajaran
                        mendatang telah dibuka dan dapat dilakukan secara
                        online. Kami memberikan kemudahan bagi orang tua untuk
                        mendaftarkan putra-putrinya dari rumah.
                    </p>
                </div>

                <div class="grid-3">
                    <Card title="1. Pengisian Formulir Pendataan" icon="📝">
                        <p>
                            Ayah/Bunda dapat mengisi data diri calon siswa
                            secara online melalui tautan resmi Google Form kami.
                        </p>
                    </Card>
                    <Card title="2. Konfirmasi" icon="💬">
                        <p>
                            Kami akan membuat group WA SPMB untuk invite calon
                            murid baru, memberikan informasi alur dan biaya di 1
                            tahun sebelum Tahun ajaran dimulai.
                        </p>
                    </Card>
                    <Card title="3. Informasi Lanjutan" icon="📅">
                        <p>
                            Pengisian formulir berbayar dan jadwal
                            observasi/wawancara akan diinformasikan kembali
                            melalui group WA SPMB.
                        </p>
                    </Card>
                </div>

                <div class="cta-box animate-fade-up">
                    <div class="cta-glow"></div>
                    <h2>
                        Formulir <span class="text-gradient"
                            >Pendataan Online</span
                        >
                    </h2>
                    <p>
                        Klik tombol di bawah ini untuk mulai mengisi formulir
                        pendataan.
                    </p>
                    <div class="cta-actions">
                        <a
                            href="https://forms.gle/5VxkCCNa5ntLActWA"
                            target="_blank"
                            class="btn btn-primary btn-large"
                            >📋 Isi Formulir SPMB</a
                        >
                        <a
                            href="https://api.whatsapp.com/send?phone=6282225341300"
                            target="_blank"
                            class="btn btn-wa">💬 Hubungi Admin SPMB</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("visible");
                }
            });
        },
        { threshold: 0.1 },
    );
    document
        .querySelectorAll(".animate-fade-up")
        .forEach((el) => observer.observe(el));
</script>

<style>
    .page-header {
        position: relative;
        padding: 6rem 0 4rem;
        text-align: center;
        overflow: hidden;
    }

    .page-header-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center top,
            rgba(233, 30, 140, 0.12) 0%,
            transparent 60%
        );
        z-index: -1;
    }

    .page-title {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .page-subtitle {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .info-text {
        text-align: center;
        font-size: 1.1rem;
        line-height: 1.8;
        max-width: 800px;
        margin: 0 auto 3rem;
        color: var(--color-text-muted);
    }

    .cta-box {
        position: relative;
        text-align: center;
        padding: 4rem 2rem;
        border-radius: var(--radius-xl);
        max-width: 800px;
        margin: 3rem auto 0;
        background: var(--color-surface);
        border: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
    }

    .cta-glow {
        position: absolute;
        top: -50%;
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        height: 300px;
        background: radial-gradient(
            circle,
            rgba(233, 30, 140, 0.15) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .cta-box h2 {
        margin-bottom: 1rem;
        position: relative;
    }

    .cta-box p {
        margin-bottom: 2rem;
        color: var(--color-text-muted);
        position: relative;
    }

    .cta-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        position: relative;
    }

    .btn-large {
        font-size: 1.15rem;
        padding: 1rem 2.5rem;
    }

    .btn-wa {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 1.15rem;
        background: #25d366;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    }

    .btn-wa:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(37, 211, 102, 0.5);
    }

    @media (max-width: 768px) {
        .page-title {
            font-size: 2.25rem;
        }
        .cta-box {
            padding: 3rem 1.5rem;
        }
        .cta-actions {
            flex-direction: column;
        }
    }
</style>
