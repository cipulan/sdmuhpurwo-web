---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Profil Sekolah">
    <main>
        <!-- Hero Section -->
        <section class="page-header">
            <div class="container">
                <h1 class="page-title">
                    Profil <span class="text-gradient">Sekolah</span>
                </h1>
                <p class="page-subtitle">SD Muhammadiyah Purwodiningratan</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section class="section">
            <div class="container container-sm">
                <div class="intro-card glass">
                    <div class="intro-grid">
                        <div class="intro-content">
                            <p class="lead-text">
                                Hadir sebagai lembaga pendidikan dasar swasta
                                yang telah berdiri sejak tahun 1969 di Kota
                                Yogyakarta. Memadukan penguatan akademik dengan
                                pembentukan akhlak mulia berlandaskan
                                nilai-nilai keislaman dan kemuhammadiyahan, kami
                                berkomitmen mendampingi tumbuh kembang setiap
                                anak menjadi pribadi yang berilmu, berakhlak,
                                dan siap menghadapi tantangan zaman.
                            </p>
                        </div>
                        <div class="intro-image-wrapper">
                            <img
                                src="/images/general-profile-picture.png"
                                alt="SD Muhammadiyah Purwodiningratan 2"
                                class="intro-image"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sejarah Singkat -->
        <section class="section">
            <div class="container container-sm">
                <div class="history-content glass">
                    <h2 class="section-title">
                        Sejarah <span class="text-gradient">Singkat</span>
                    </h2>
                    <p>
                        SD Muhammadiyah Purwodiningratan merupakan sekolah dasar
                        swasta yang telah berdiri sejak tahun 1969 di
                        Purwodiningratan Ng I/902 C/D, Ngampilan, Kota
                        Yogyakarta. Berdiri di atas lahan seluas 600 meter
                        persegi, sekolah ini berada di bawah naungan Yayasan
                        Pimpinan Daerah Muhammadiyah (PDM) Kota Yogyakarta dan
                        telah lebih dari lima dekade berkontribusi dalam
                        mencetak generasi yang berakhlak mulia dan berprestasi
                        akademik.
                    </p>
                    <p>
                        Seiring perkembangan zaman, SD Muhammadiyah
                        Purwodiningratan 2 terus meningkatkan kualitas
                        pendidikannya, ditandai dengan perolehan <strong
                            >akreditasi A pada 10 November 2017</strong
                        >. Sekolah ini menerapkan sistem pendidikan sehari penuh
                        (<em>full day school</em>) selama 5 hari dalam sepekan,
                        didukung lingkungan belajar yang kondusif serta
                        fasilitas yang memadai — termasuk akses listrik PLN dan
                        jaringan internet yang baik untuk menunjang proses
                        belajar mengajar yang modern dan interaktif.
                    </p>
                    <p>
                        Hingga kini, SD Muhammadiyah Purwodiningratan dikenal
                        sebagai salah satu pilihan sekolah dasar berkualitas di
                        Kota Yogyakarta, dengan reputasi baik dalam membina
                        siswa yang berakhlak mulia sekaligus unggul secara
                        akademik.
                    </p>
                </div>
            </div>
        </section>

        <!-- Visi, Misi, Tujuan -->
        <section class="section alt-bg">
            <div class="container">
                <div class="vmt-grid">
                    <!-- Visi -->
                    <div class="vmt-card glass">
                        <div class="icon-wrapper">👁️</div>
                        <h3>Visi Sekolah</h3>
                        <blockquote class="vision-text">
                            "Mewujudkan generasi yang berakhlaqul karimah,
                            berprestasi, mencintai lingkungan, berwawasan
                            teknologi, dan berkarakter Pelajar Pancasila."
                        </blockquote>
                    </div>

                    <!-- Tujuan -->
                    <div class="vmt-card glass">
                        <div class="icon-wrapper">🎯</div>
                        <h3>Tujuan Pendidikan</h3>
                        <ul class="styled-list">
                            <li>
                                Menghasilkan lulusan yang beriman, bertakwa, dan
                                berakhlak mulia.
                            </li>
                            <li>
                                Membentuk siswa yang unggul secara akademik
                                maupun non-akademik.
                            </li>
                            <li>
                                Menumbuhkan kesadaran dan kepedulian lingkungan
                                sejak usia dini.
                            </li>
                            <li>
                                Membekali siswa dengan kecakapan digital dan
                                teknologi dasar.
                            </li>
                            <li>
                                Mencetak generasi yang berkarakter sesuai
                                nilai-nilai Pelajar Pancasila.
                            </li>
                        </ul>
                    </div>

                    <!-- Misi -->
                    <div class="vmt-card glass full-width">
                        <div class="icon-wrapper">🚀</div>
                        <h3>Misi Sekolah</h3>
                        <div class="mission-grid">
                            <div class="mission-item">
                                <h4>1. Berakhlaqul Karimah</h4>
                                <p>
                                    Menanamkan nilai-nilai keimanan, ketakwaan,
                                    dan akhlak mulia dalam keseharian siswa
                                    sesuai tuntunan Al-Qur'an, Sunnah, dan
                                    nilai-nilai kemuhammadiyahan.
                                </p>
                            </div>
                            <div class="mission-item">
                                <h4>2. Berprestasi</h4>
                                <p>
                                    Mengembangkan potensi akademik dan
                                    non-akademik siswa secara optimal melalui
                                    proses pembelajaran yang aktif, kreatif, dan
                                    bermakna.
                                </p>
                            </div>
                            <div class="mission-item">
                                <h4>3. Mencintai Lingkungan</h4>
                                <p>
                                    Menumbuhkan kepedulian dan tanggung jawab
                                    siswa terhadap lingkungan melalui pembiasaan
                                    hidup bersih, sehat, dan ramah lingkungan.
                                </p>
                            </div>
                            <div class="mission-item">
                                <h4>4. Berwawasan Teknologi</h4>
                                <p>
                                    Mengintegrasikan literasi digital dan
                                    pemanfaatan teknologi dalam proses
                                    pembelajaran agar siswa siap menghadapi
                                    perkembangan zaman.
                                </p>
                            </div>
                            <div class="mission-item">
                                <h4>5. Berpendidikan Pelajar Pancasila</h4>
                                <p>
                                    Menguatkan karakter siswa yang
                                    beriman-bertakwa, berkebinekaan global,
                                    bergotong royong, mandiri, bernalar kritis,
                                    dan kreatif sesuai Profil Pelajar Pancasila.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Identitas Sekolah & Mengapa Memilih Kami -->
        <section class="section">
            <div class="container">
                <div class="info-grid">
                    <div class="identitas-card glass">
                        <h2 class="section-title">
                            Identitas <span class="text-gradient">Sekolah</span>
                        </h2>
                        <div class="table-responsive">
                            <table class="identity-table">
                                <tbody>
                                    <tr
                                        ><th>Nama Sekolah</th><td
                                            >SD Muhammadiyah Purwodiningratan</td
                                        ></tr
                                    >
                                    <tr><th>NPSN</th><td>19516</td></tr>
                                    <tr
                                        ><th>Jenjang</th><td
                                            >Sekolah Dasar (SD)</td
                                        ></tr
                                    >
                                    <tr><th>Status</th><td>Swasta</td></tr>
                                    <tr
                                        ><th>Naungan</th><td
                                            >Yayasan PDM Kota Yogyakarta</td
                                        ></tr
                                    >
                                    <tr
                                        ><th>Akreditasi</th><td
                                            >A (10 November 2017)</td
                                        ></tr
                                    >
                                    <tr
                                        ><th>Waktu Belajar</th><td
                                            >Full Day (5 Hari Sekolah)</td
                                        ></tr
                                    >
                                    <tr><th>Luas Tanah</th><td>600 m²</td></tr>
                                    <tr><th>Tahun Berdiri</th><td>1969</td></tr>
                                    <tr
                                        ><th>Alamat</th><td
                                            >Purwodiningratan Ng I/902 C/D, Kec.
                                            Ngampilan, Kota Yogyakarta, DIY
                                            55261</td
                                        ></tr
                                    >
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="why-us-card glass">
                        <h2 class="section-title">
                            Mengapa <span class="text-gradient"
                                >Memilih Kami?</span
                            >
                        </h2>
                        <div class="why-list">
                            <div class="why-item">
                                <span class="check-icon">✓</span>
                                <p>
                                    Pembinaan akhlak dan keislaman yang
                                    terintegrasi dalam setiap kegiatan belajar.
                                </p>
                            </div>
                            <div class="why-item">
                                <span class="check-icon">✓</span>
                                <p>
                                    Program-program unggulan yang mendukung
                                    tumbuh kembang siswa secara utuh.
                                </p>
                            </div>
                            <div class="why-item">
                                <span class="check-icon">✓</span>
                                <p>
                                    Lingkungan belajar yang aman, nyaman, dan
                                    mendukung kreativitas anak.
                                </p>
                            </div>
                            <div class="why-item">
                                <span class="check-icon">✓</span>
                                <p>
                                    Sinergi erat antara sekolah dan orang tua
                                    dalam mendampingi pendidikan anak.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-header {
        padding: 6rem 0 3rem;
        text-align: center;
        background: var(--gradient-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .page-title {
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 1.2rem;
        font-weight: 500;
    }

    .container-sm {
        max-width: 900px;
        margin: 0 auto;
    }

    .intro-card {
        padding: 2.5rem;
        border-radius: var(--radius-xl);
    }

    .intro-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
    }

    .lead-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--color-text);
    }

    .intro-image-wrapper {
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--color-border-light);
        box-shadow: var(--shadow-lg);
        max-width: 350px;
        margin: 0 auto;
    }

    .intro-image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.5s ease;
    }

    .intro-image:hover {
        transform: scale(1.05);
    }

    .history-content {
        padding: 3rem;
        border-radius: var(--radius-xl);
    }

    .history-content p {
        margin-bottom: 1.5rem;
        line-height: 1.8;
        color: var(--color-text-muted);
    }

    .section-title {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .alt-bg {
        background: rgba(13, 13, 26, 0.02);
    }

    :global([data-theme="dark"]) .alt-bg {
        background: rgba(255, 255, 255, 0.02);
    }

    .vmt-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .vmt-card {
        padding: 2.5rem;
        border-radius: var(--radius-xl);
        display: flex;
        flex-direction: column;
    }

    .vmt-card.full-width {
        grid-column: 1 / -1;
    }

    .icon-wrapper {
        font-size: 3rem;
        margin-bottom: 1.5rem;
        line-height: 1;
    }

    .vmt-card h3 {
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        color: var(--color-text);
    }

    .vision-text {
        font-size: 1.5rem;
        line-height: 1.6;
        font-style: italic;
        color: var(--color-primary);
        border-left: 4px solid var(--color-primary);
        padding-left: 1.5rem;
        margin: auto 0;
    }

    .styled-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .styled-list li {
        position: relative;
        padding-left: 1.5rem;
        color: var(--color-text-muted);
        line-height: 1.6;
    }

    .styled-list li::before {
        content: "•";
        color: var(--color-primary);
        position: absolute;
        left: 0;
        font-size: 1.5rem;
        line-height: 1;
    }

    .mission-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .mission-item {
        background: var(--color-surface);
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
    }

    .mission-item h4 {
        color: var(--color-primary-light);
        margin-bottom: 0.75rem;
        font-size: 1.1rem;
    }

    .mission-item p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 2rem;
    }

    .identitas-card,
    .why-us-card {
        padding: 2.5rem;
        border-radius: var(--radius-xl);
    }

    .identity-table {
        width: 100%;
        border-collapse: collapse;
    }

    .identity-table th,
    .identity-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--color-border);
        text-align: left;
    }

    .identity-table th {
        width: 35%;
        color: var(--color-text);
        font-weight: 600;
    }

    .identity-table td {
        color: var(--color-text-muted);
    }

    .identity-table tr:last-child th,
    .identity-table tr:last-child td {
        border-bottom: none;
    }

    .why-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .why-item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .check-icon {
        background: var(--color-primary);
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .why-item p {
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0;
    }

    @media (max-width: 992px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .intro-grid {
            grid-template-columns: 1fr;
        }

        .intro-image-wrapper {
            order: -1; /* Image on top on mobile */
        }

        .vmt-grid {
            grid-template-columns: 1fr;
        }

        .history-content {
            padding: 2rem 1.5rem;
        }
    }
</style>
